generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum LocalityLevel {
  PROVINCE
  DISTRICT
  LOCALITY
}

enum ProviderStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VerificationDecision {
  APPROVED
  REJECTED
  SUSPENDED
  REINSTATED
}

enum ConversationRole {
  CUSTOMER
  PROVIDER
}

enum MessageType {
  TEXT
  IMAGE
  OFFER
  BOOKING
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
  SUPERSEDED
}

enum BookingStatus {
  CONFIRMED
  PROVIDER_COMPLETED
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_PROVIDER
  NO_SHOW_REPORTED
  NO_SHOW_CUSTOMER
  NO_SHOW_PROVIDER
  DISPUTED
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
}

enum DisputeType {
  ISSUE
  NO_SHOW
}

enum DisputeStatus {
  OPEN
  AWAITING_RESPONSE
  IN_REVIEW
  RESOLVED
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  passwordHash    String           @map("password_hash")
  fullName        String           @map("full_name")
  status          UserStatus       @default(ACTIVE)
  suspendedReason String?          @map("suspended_reason")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles           UserRole[]
  refreshTokens   RefreshToken[]
  customerProfile CustomerProfile?
  providerProfile ProviderProfile?
  verifications   ProviderVerification[] @relation("ReviewedByAdmin")
  notifications   Notification[]
  customerConvos  Conversation[]            @relation("CustomerConversations")
  convoParticipants ConversationParticipant[]
  sentMessages    Message[]
  customerOffers  ServiceOffer[]            @relation("CustomerOffers")
  customerBookings Booking[]                @relation("CustomerBookings")
  cancelledBookings Booking[]               @relation("CancelledByUser")
  bookingHistory  BookingStatusHistory[]
  openedDisputes  Dispute[]                 @relation("OpenedDisputes")
  accusedDisputes Dispute[]                 @relation("AccusedDisputes")
  resolvedDisputes Dispute[]                @relation("ResolvedDisputes")
  reviews         Review[]
  pushTokens      PushToken[]

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, role])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("refresh_tokens")
}

model CustomerProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  profilePhotoUrl   String?  @map("profile_photo_url")
  defaultLocalityId String?  @map("default_locality_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("customer_profiles")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt])
  @@map("notifications")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  iconKey   String   @map("icon_key")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  providerServices ProviderService[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model ProviderProfile {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @unique @map("user_id") @db.Uuid
  displayName     String         @map("display_name")
  photoUrl        String?        @map("photo_url")
  photoFileId     String?        @map("photo_file_id")
  description     String?
  experienceYears Int?           @map("experience_years")
  status          ProviderStatus @default(DRAFT)
  isAcceptingWork Boolean        @default(true) @map("is_accepting_work")
  submittedAt     DateTime?      @map("submitted_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  services      ProviderService[]
  serviceArea   ServiceArea?
  availability  AvailabilityWindow[]
  portfolio     PortfolioMedia[]
  verifications ProviderVerification[]
  conversations Conversation[]
  offers        ServiceOffer[]
  bookings      Booking[]
  reviews       Review[]

  @@index([status])
  @@map("provider_profiles")
}

model ProviderService {
  id                String   @id @default(uuid()) @db.Uuid
  providerProfileId String   @map("provider_profile_id") @db.Uuid
  categoryId        String   @map("category_id") @db.Uuid
  title             String
  description       String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([providerProfileId, categoryId, title])
  @@index([categoryId])
  @@map("provider_services")
}

model ServiceArea {
  id                String                                @id @default(uuid()) @db.Uuid
  providerProfileId String                                @unique @map("provider_profile_id") @db.Uuid
  localityId        String                                @map("locality_id") @db.Uuid
  center            Unsupported("geography(Point, 4326)")
  radiusKm          Int                                   @map("radius_km")
  createdAt         DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  locality        Locality        @relation(fields: [localityId], references: [id], onDelete: Restrict)

  @@index([localityId])
  @@map("service_areas")
}

model AvailabilityWindow {
  id                String   @id @default(uuid()) @db.Uuid
  providerProfileId String   @map("provider_profile_id") @db.Uuid
  dayOfWeek         Int      @map("day_of_week")
  startTime         String   @map("start_time")
  endTime           String   @map("end_time")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([providerProfileId, dayOfWeek])
  @@map("availability_windows")
}

model PortfolioMedia {
  id                String   @id @default(uuid()) @db.Uuid
  providerProfileId String   @map("provider_profile_id") @db.Uuid
  imageUrl          String   @map("image_url")
  fileId            String   @map("file_id")
  caption           String?
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([providerProfileId, sortOrder])
  @@map("portfolio_media")
}

model ProviderVerification {
  id                String               @id @default(uuid()) @db.Uuid
  providerProfileId String               @map("provider_profile_id") @db.Uuid
  decision          VerificationDecision
  reason            String?
  reviewedByUserId  String               @map("reviewed_by_user_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  reviewedBy      User            @relation("ReviewedByAdmin", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([providerProfileId, createdAt])
  @@map("provider_verifications")
}

model Locality {
  id            String                                @id @default(uuid()) @db.Uuid
  parentId      String?                               @map("parent_id") @db.Uuid
  level         LocalityLevel
  name          String
  slug          String                                @unique
  center        Unsupported("geography(Point, 4326)")
  isServiceable Boolean                               @default(true) @map("is_serviceable")
  createdAt     DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Locality?  @relation("LocalityHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Locality[] @relation("LocalityHierarchy")
  serviceAreas ServiceArea[]

  @@index([parentId])
  @@index([level, isServiceable])
  @@map("localities")
}

model Conversation {
  id                String   @id @default(uuid()) @db.Uuid
  customerUserId    String   @map("customer_user_id") @db.Uuid
  providerProfileId String   @map("provider_profile_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customerUser    User                      @relation("CustomerConversations", fields: [customerUserId], references: [id], onDelete: Restrict)
  providerProfile ProviderProfile           @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  participants    ConversationParticipant[]
  messages        Message[]
  offers          ServiceOffer[]
  bookings        Booking[]

  @@unique([customerUserId, providerProfileId])
  @@map("conversations")
}

model ConversationParticipant {
  id                 String           @id @default(uuid()) @db.Uuid
  conversationId     String           @map("conversation_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  roleInConversation ConversationRole @map("role_in_conversation")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id              String      @id @default(uuid()) @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  senderId        String      @map("sender_id") @db.Uuid
  type            MessageType
  body            String?
  imageUrl        String?     @map("image_url")
  imageFileId     String?     @map("image_file_id")
  offerId         String?     @map("offer_id") @db.Uuid
  bookingId       String?     @map("booking_id") @db.Uuid
  clientMessageId String      @map("client_message_id")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz(3)
  readAt          DateTime?   @map("read_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@map("messages")
}

model ServiceOffer {
  id                String      @id @default(uuid()) @db.Uuid
  conversationId    String      @map("conversation_id") @db.Uuid
  providerProfileId String      @map("provider_profile_id") @db.Uuid
  customerUserId    String      @map("customer_user_id") @db.Uuid
  serviceName       String      @map("service_name")
  description       String
  price             Decimal     @db.Decimal(12, 2)
  proposedStart     DateTime    @map("proposed_start") @db.Timestamptz(3)
  terms             String?
  status            OfferStatus @default(PENDING)
  expiresAt         DateTime    @map("expires_at") @db.Timestamptz(3)
  respondedAt       DateTime?   @map("responded_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation    Conversation    @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  customerUser    User            @relation("CustomerOffers", fields: [customerUserId], references: [id], onDelete: Restrict)
  booking         Booking?

  @@index([conversationId, createdAt])
  @@index([status, expiresAt])
  @@map("service_offers")
}

model Booking {
  id                  String                                 @id @default(uuid()) @db.Uuid
  offerId             String                                 @unique @map("offer_id") @db.Uuid
  conversationId      String                                 @map("conversation_id") @db.Uuid
  customerUserId      String                                 @map("customer_user_id") @db.Uuid
  providerProfileId   String                                 @map("provider_profile_id") @db.Uuid
  serviceName         String                                 @map("service_name")
  description         String
  price               Decimal                                @db.Decimal(12, 2)
  scheduledStart      DateTime                               @map("scheduled_start") @db.Timestamptz(3)
  serviceAddress      String                                 @map("service_address")
  serviceLocation     Unsupported("geography(Point, 4326)")? @map("service_location")
  status              BookingStatus                          @default(CONFIRMED)
  providerCompletedAt DateTime?                              @map("provider_completed_at") @db.Timestamptz(3)
  completedAt         DateTime?                              @map("completed_at") @db.Timestamptz(3)
  cancelledAt         DateTime?                              @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId   String?                                @map("cancelled_by_user_id") @db.Uuid
  cancelReason        String?                                @map("cancel_reason")
  createdAt           DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  offer           ServiceOffer           @relation(fields: [offerId], references: [id], onDelete: Restrict)
  conversation    Conversation           @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  customerUser    User                   @relation("CustomerBookings", fields: [customerUserId], references: [id], onDelete: Restrict)
  providerProfile ProviderProfile        @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  cancelledByUser User?                  @relation("CancelledByUser", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  history         BookingStatusHistory[]
  disputes        Dispute[]
  review          Review?

  @@index([customerUserId, createdAt])
  @@index([providerProfileId, createdAt])
  @@index([status])
  @@map("bookings")
}

model BookingStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  actorType   ActorType      @map("actor_type")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  reason      String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  actorUser User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model Dispute {
  id               String         @id @default(uuid()) @db.Uuid
  bookingId        String         @map("booking_id") @db.Uuid
  type             DisputeType
  openedByUserId   String         @map("opened_by_user_id") @db.Uuid
  accusedUserId    String?        @map("accused_user_id") @db.Uuid
  reason           String
  response         String?
  respondedAt      DateTime?      @map("responded_at") @db.Timestamptz(3)
  responseDeadline DateTime?      @map("response_deadline") @db.Timestamptz(3)
  status           DisputeStatus
  outcome          BookingStatus?
  resolutionNote   String?        @map("resolution_note")
  resolvedByUserId String?        @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?      @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  openedBy   User    @relation("OpenedDisputes", fields: [openedByUserId], references: [id], onDelete: Restrict)
  accused    User?   @relation("AccusedDisputes", fields: [accusedUserId], references: [id], onDelete: Restrict)
  resolvedBy User?   @relation("ResolvedDisputes", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([status, responseDeadline])
  @@map("disputes")
}

model Review {
  id                String   @id @default(uuid()) @db.Uuid
  bookingId         String   @unique @map("booking_id") @db.Uuid
  customerUserId    String   @map("customer_user_id") @db.Uuid
  providerProfileId String   @map("provider_profile_id") @db.Uuid
  rating            Int
  comment           String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking         Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerUser    User            @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)

  @@index([providerProfileId, createdAt])
  @@map("reviews")
}

model PushToken {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  expoPushToken String   @unique @map("expo_push_token")
  platform      String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}
